BootStrap: docker
From: ubuntu:24.04

%environment
    export LC_ALL=en_US.utf-8
    export LANG=en_US.utf-8
    export LANGUAGE=en_US.UTF-8
    # Set BASH_ENV which points to init file loaded during non-interactive shell
    export BASH_ENV=/opt/etc/bashrc
    export PATH="/opt/mamba/bin:$PATH"
    # POSIX-compatible sourcing (dash on ubuntu:24.04 does not accept `source`)
    . /opt/etc/bashrc

%post
    # Create target dir for non-root-accessible bashrc
    mkdir -p /opt/etc
    mkdir -p /opt/conda

    # Ensure locales packages installed
    sed -i '/xenial.*universe/s/^#//g' /etc/apt/sources.list
    apt-get -y update
    apt-get install -y locales locales-all
    apt-get -y install g++
    apt-get install -y wget

    #Install Mamba
    readonly mamba_installer="Mambaforge-$(uname)-$(uname -m).sh"
    readonly mamba_version="4.10.3-4"
    readonly mamba_prefix="/opt/mamba"
    wget "https://github.com/conda-forge/miniforge/releases/download/${mamba_version}/${mamba_installer}"
    bash "${mamba_installer}" -b -p "${mamba_prefix}"
    rm "${mamba_installer}"
    export PATH="/opt/mamba/bin:$PATH"

    # Create environment using mamba
    ENVNAME="lrrna"
    mamba create -y -n ${ENVNAME} 
    mamba install -n ${ENVNAME} samtools pychopper  minimap2 isoquant stringtie gffcompare multiqc mosdepth nanopack rseqc bedtools rustqc -c bioconda

    # Install IsoMatch v0.6.1 (Rust binary from GitHub releases)
    ISOMATCH_VERSION="0.6.1"
    ISOMATCH_URL="https://github.com/zhengxinchang/isomatch/releases/download/v${ISOMATCH_VERSION}/isomatch-v${ISOMATCH_VERSION}-linux-x86_64.tar.gz"
    ISOMATCH_SHA256="d77df79dd6ad75b5e9d7a3043799a6e89db5b9e556b6b29e6322caa373b21bda"
    mkdir -p /opt/isomatch
    wget -O /tmp/isomatch.tar.gz "${ISOMATCH_URL}"
    echo "${ISOMATCH_SHA256}  /tmp/isomatch.tar.gz" | sha256sum -c -
    tar -xzf /tmp/isomatch.tar.gz -C /opt/isomatch
    chmod +x /opt/isomatch/isomatch
    rm /tmp/isomatch.tar.gz
    ln -s /opt/isomatch/isomatch /usr/local/bin/isomatch

    # Finalize bashrc file
    echo "#! /bin/bash\n\n# script to activate the conda environment" > ~/.bashrc 
    mamba init bash
    echo "echo \"Activating ${ENVNAME}\"" >>  ~/.bashrc
    echo "\nmamba activate ${ENVNAME}" >> ~/.bashrc

    # Clean up installer files
    conda clean -a

    # Copy bashrc to non-root-accessible location
    cp ~/.bashrc /opt/etc/bashrc
    
    chmod -R 755 /opt/

# %runscript
    exec /bin/bash "$@"